# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
# The key set below must stay in sync with src/core/config.py:Settings
# (enforced by tests/unit/test_config.py).
# =============================================================================

# --- Database ----------------------------------------------------------------
# PostgreSQL role used by the application.
POSTGRES_USER=postgres
# Password for the role above.
POSTGRES_PASSWORD=changeme
# Database name.
POSTGRES_DB=online_cinema
# Hostname: "db" inside docker compose, "localhost" when running natively.
POSTGRES_HOST=db
# TCP port of the database server.
POSTGRES_PORT=5432

# --- JWT ---------------------------------------------------------------------
# Signing key for access tokens.
SECRET_KEY_ACCESS=your-secret-access-key
# Signing key for refresh tokens (must differ from the access key).
SECRET_KEY_REFRESH=your-secret-refresh-key
# JWS algorithm used for both token types.
JWT_ALGORITHM=HS256
# Access token lifetime, in minutes.
ACCESS_TOKEN_TTL_MINUTES=30
# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=7
# Account activation token lifetime, in hours.
ACTIVATION_TOKEN_TTL_HOURS=24
# Password reset token lifetime, in minutes.
PASSWORD_RESET_TTL_MINUTES=15

# --- Email -------------------------------------------------------------------
# SMTP host: "mailhog" inside docker compose.
EMAIL_HOST=mailhog
# SMTP port: 1025 for MailHog, 587 for a real TLS relay.
EMAIL_PORT=1025
# SMTP username (empty for MailHog).
EMAIL_USER=user@example.com
# SMTP password (empty for MailHog).
EMAIL_PASSWORD=your-email-password
# Address used in the From header of outgoing mail.
EMAIL_FROM=noreply@example.com
# Whether to negotiate STARTTLS; false for MailHog.
EMAIL_USE_TLS=false

# --- Redis and Celery --------------------------------------------------------
# Redis connection string used by the application cache.
REDIS_URL=redis://redis:6379/0
# Broker Celery publishes tasks to.
CELERY_BROKER_URL=redis://redis:6379/1
# Backend Celery stores task results in.
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- S3 / MinIO --------------------------------------------------------------
# S3 endpoint URL: the MinIO service inside docker compose.
S3_ENDPOINT=http://minio:9000
# Access key (MinIO root user).
S3_ACCESS_KEY=minioadmin
# Secret key (MinIO root password), at least 8 characters.
S3_SECRET_KEY=minioadmin
# Bucket that stores movie posters and avatars.
S3_BUCKET_NAME=online-cinema

# --- Stripe ------------------------------------------------------------------
# Stripe secret API key (test mode key in development).
STRIPE_SECRET_KEY=sk_test_your-key-here
# Signing secret used to verify Stripe webhook payloads.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# URL Stripe redirects to after a successful checkout.
STRIPE_SUCCESS_URL=http://localhost:8000/api/v1/payments/success
# URL Stripe redirects to after a cancelled checkout.
STRIPE_CANCEL_URL=http://localhost:8000/api/v1/payments/cancel

# --- Application -------------------------------------------------------------
# Deployment environment: development, test or production.
ENVIRONMENT=development
# Whether /docs and /redoc are exposed.
DOCS_ENABLED=true
